# Magazine Core 11.9 — plain HTTP works by default; HTTPS is optional later.
HOST=0.0.0.0
PORT=3000
SITE_URL=http://localhost:3000

# Real news refresh. It always runs outside visitor requests.
RSS_ENABLED=true
RSS_INITIAL_DELAY_SECONDS=1
RSS_STEP_SECONDS=12
RSS_TIMEOUT_MS=5000

# Limits for weak VMs
RSS_MAX_FEED_BYTES=700000
RSS_MAX_ITEMS_PER_SOURCE=10
RSS_MAX_TOTAL_ITEMS=240
RSS_MAX_ITEM_AGE_DAYS=45
